OPENCLAW_GATEWAY_TOKEN=replace-with-a-unique-random-token
BROWSER_TOKEN=replace-with-a-separate-unique-random-token
# Set true only for a genuinely new install with no existing ~/.openclaw/workspace.
# Existing deployments should keep false so a missing legacy workspace stops startup safely.
OPENCLAW_ALLOW_EMPTY_LEGACY_WORKSPACE=false
# Add the model provider credentials needed by your chosen model.
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# Optional generic external MCP service, configured on first startup only.
# MCP_SERVER_URL=http://example-service:3100/mcp
# MCP_SERVER_TOKEN=the-same-private-token-as-the-mcp-service
