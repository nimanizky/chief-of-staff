OPENCLAW_GATEWAY_TOKEN=replace-with-a-unique-random-token
BROWSER_TOKEN=replace-with-a-separate-unique-random-token
# Set true only for a genuinely new install with no existing ~/.openclaw/workspace.
# Existing deployments should keep false so a missing legacy workspace stops startup safely.
OPENCLAW_ALLOW_EMPTY_LEGACY_WORKSPACE=false
# Server-side Obsidian vault sync poll interval.
MEMORY_SYNC_INTERVAL_SECONDS=60
# Add the model provider credentials needed by your chosen model.
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# Optional generic external MCP service, configured on first startup only.
# MCP_SERVER_URL=http://example-service:3100/mcp
# MCP_SERVER_TOKEN=the-same-private-token-as-the-mcp-service
# Optional ChatGPT-facing MCP endpoint. Disabled by default.
MCP_SERVER_ENABLED=false
# Keep 127.0.0.1 unless a trusted reverse proxy/tunnel on the Docker network must reach this port.
# If using a separate reverse-proxy container, set MCP_BIND_HOST=0.0.0.0.
MCP_BIND_HOST=127.0.0.1
MCP_PORT=3200
# Public HTTPS origin only (no /mcp path); the proxy routes /mcp and /.well-known/* to gateway:3200.
MCP_PUBLIC_URL=https://mcp.example.com
# Configure an OAuth 2.1 identity provider that supports MCP authorization, PKCE S256, refresh tokens,
# CIMD or DCR, and the resource parameter. The access token must be a JWT with a JWKS-verifiable signature.
MCP_OAUTH_ISSUER=https://your-identity-provider.example/
MCP_OAUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
# Must match MCP_PUBLIC_URL and the access token's aud/resource claim.
MCP_OAUTH_AUDIENCE=https://mcp.example.com
# Exact stable sub claim allowed to access this personal OpenClaw server.
MCP_OAUTH_ALLOWED_SUBJECT=replace-with-your-provider-subject
MCP_OAUTH_SCOPE_READ=openclaw.read
MCP_OAUTH_SCOPE_WRITE=openclaw.write
# Optional: enable ChatGPT's workspace_sync tool by dispatching the shared GitHub Actions workflow.
# Use a fine-grained token scoped to this repository with Actions: read/write permission.
# MCP_SYNC_GITHUB_TOKEN=github_pat_replace_me
MCP_SYNC_GITHUB_REPOSITORY=nimanizky/chief-of-staff
MCP_SYNC_GITHUB_WORKFLOW=openclaw-obsidian-manual-sync.yml
MCP_SYNC_GITHUB_REF=main
