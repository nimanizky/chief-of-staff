# Mistral (primary receipt parser)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_API_BASE=https://api.mistral.ai
GEMINI_API_KEY=your_gemini_api_key

# Optional OpenAI fallback (unused by default parser)
OPENAI_API_KEY=

# Telegram (used by OpenClaw channel runtime)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_API_BASE=https://api.telegram.org

# Google Sheets
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
RECEIPT_SPREADSHEET_ID=your_google_sheet_id
RECEIPT_SHEET_RAW=receipts_raw
RECEIPT_SHEET_MONTHLY=monthly_breakdown
CICILAN_SHEET_RAW=cicilan_raw
MONTHLY_BREAKDOWN_V2_SHEET=monthly_breakdown_v2
WEALTH_SHEET_RAW=wealth_snapshot_raw
WEALTH_BREAKDOWN_SHEET=wealth_breakdown
BUDGET_CONFIG_SHEET=budget_config
BUDGET_STATUS_SHEET=budget_status
FINANCE_WEEKLY_SPEND_SHEET=cc_weekly_spend
FINANCE_PAYMENT_CALENDAR_SHEET=cc_payment_calendar

# Read-only finance digest
FINANCE_DIGEST_ENABLED=false
FINANCE_DIGEST_TIMEZONE=Asia/Jakarta
FINANCE_DIGEST_LOOKAHEAD_DAYS=14
FINANCE_DIGEST_TELEGRAM_CHAT_ID=

# Runtime
RECEIPT_MAX_PDF_PAGES=3
RECEIPT_ACCEPT_PDF=false
RECEIPT_STRICT_MEMORY_ONLY=false
OPENCLAW_MEMORY_VAULT_PATH=/absolute/path/to/chief-of-staff/openclaw-obsidian-vault
OPENCLAW_MEMORY_GIT_AUTO_COMMIT=false
OPENCLAW_MEMORY_GIT_AUTO_PUSH=false
RECEIPT_JOURNAL_PATH=/absolute/path/to/chief-of-staff/openclaw-obsidian-vault/memory/receipts/receipt-journal.md
WISHLIST_FILE_PATH=/absolute/path/to/chief-of-staff/openclaw-obsidian-vault/memory/wishlists/backlog-wishlist.md
# Use a comma-separated list of WhatsApp group ids, or * to allow any WhatsApp group that reaches this task.
WISHLIST_ALLOWED_GROUPS=120363408773982912@g.us,120363416177839839@g.us
WISHLIST_EXACT_DISPATCH=true
WISHLIST_MODEL_CLASSIFIER=true
WISHLIST_MODEL_NAME=gemini-3.1-flash-lite
RECEIPT_SAVE_JOURNAL=true
RECEIPT_SAVE_SHEETS=true
FINANCE_SQLITE_PATH=./data/finance.sqlite
RECEIPT_SHEETS_SYNC_INTERVAL_MS=30000
RECEIPT_CONFIRMATION_TTL_MS=1800000
NODE_ENV=development
TZ=Asia/Jakarta
OPENCLAW_HOME=/absolute/path/to/chief-of-staff/openclaw-platform/.openclaw-home

# Budget alerts remain opt-in until the production target is verified.
BUDGET_ALERT_ENABLED=false
BUDGET_ALERT_CHANNEL=whatsapp
BUDGET_ALERT_TARGET=
BUDGET_ALERT_ACCOUNT=
BUDGET_ALERT_MONTH_MODE=current

OPENROUTER_API_KEY=xxxxxx
GROQ_API_KEY=xxxxx
