{
  "name": "openclaw-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:cicilan && npm run test:receipt-pdf && npm run test:wishlist && npm run test:finance && npm run test:wealth && npm run test:budget && npm run test:finance-api",
    "build": "tsc -p tsconfig.json",
    "validate-schema": "tsx src/scripts/validate_receipt_schema.ts",
    "check-classification": "tsx src/scripts/check_receipt_classification.ts",
    "backfill": "tsx src/scripts/backfill_receipts.ts",
    "parity-compare": "tsx src/scripts/compare_parity_results.ts",
    "test:cicilan": "tsx src/scripts/test_cicilan_assistant.ts",
    "test:wealth": "tsx src/scripts/test_wealth_assistant.ts",
    "test:receipt-pdf": "tsx src/scripts/test_receipt_pdf_routing.ts",
    "test:wishlist": "tsx src/scripts/test_wishlist_assistant.ts",
    "test:finance": "tsx src/scripts/test_finance_digest.ts",
    "test:finance-api": "npm run build && node dist/scripts/test_finance_api.js",
    "test:receipt-sqlite": "npm run build && node dist/scripts/test_receipt_sqlite.js",
    "finance:digest:preview": "tsx src/scripts/send_finance_digest.ts --preview --force",
    "finance:digest:send": "tsx src/scripts/send_finance_digest.ts",
    "finance:sheets-sync:once": "tsx src/scripts/sync_receipt_sheets.ts --once",
    "finance:sheets-sync": "node dist/scripts/sync_receipt_sheets.js",
    "test:budget": "tsx src/scripts/test_budget_guardrail.ts",
    "budget:send": "node dist/scripts/send_budget_guardrail.js"
  },
  "dependencies": {
    "@buape/carbon": "^0.14.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "grammy": "^1.42.0",
    "openai": "^4.104.0",
    "openclaw": "2026.10.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
