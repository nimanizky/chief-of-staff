FINANCE_API_TOKEN=replace-with-a-random-token-at-least-32-characters
FINANCE_API_PORT=3100
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS_HOST=/absolute/path/to/google-service-account.json
RECEIPT_SPREADSHEET_ID=replace-with-your-sheet-id
RECEIPT_JOURNAL_PATH=/data/receipt-journal.md
RECEIPT_SAVE_JOURNAL=false
RECEIPT_SAVE_SHEETS=true

# Receipt and wealth media parsing (ported from openclaw-platform)
MISTRAL_API_KEY=
GEMINI_API_KEY=
RECEIPT_ACCEPT_PDF=false
RECEIPT_STRICT_MEMORY_ONLY=false

# Scheduled delivery. Both senders are opt-in and no-op while disabled.
FINANCE_DIGEST_ENABLED=false
FINANCE_DIGEST_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
BUDGET_ALERT_ENABLED=false
BUDGET_ALERT_CHANNEL=whatsapp
BUDGET_ALERT_TARGET=
BUDGET_ALERT_ACCOUNT=

# Wishlist board. Comma-separated chat ids; "*" allows every WhatsApp chat.
OPENCLAW_MEMORY_VAULT_PATH=
WISHLIST_FILE_PATH=
WISHLIST_ALLOWED_GROUPS=
